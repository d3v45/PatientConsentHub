<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        A&T brand mark, drawn as vectors so it stays crisp at any DPI and needs
        no binary asset. Used at 40-64px; deliberately restrained in size.
        Replace the inner content here if A&T supplies an official logo file.
    -->
    <Style x:Key="ATLogoStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="100" Height="100">
                            <Border CornerRadius="18" Background="{StaticResource DeepBlueBrush}" />
                            <!-- medical cross, offset to the top-right corner -->
                            <Path Fill="{StaticResource AccentBrush}"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,10,10,0"
                                  Data="M 10,0 H 20 V 10 H 30 V 20 H 20 V 30 H 10 V 20 H 0 V 10 H 10 Z" />
                            <TextBlock Text="A&amp;T"
                                       FontFamily="Segoe UI"
                                       FontSize="40"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,14" />
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
