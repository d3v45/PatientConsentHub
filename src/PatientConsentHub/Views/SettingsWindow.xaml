<Window x:Class="PatientConsentHub.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Patient Consent Hub"
        Height="620" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource TitleText}" Margin="0,0,0,16" />

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Recording Location" Style="{StaticResource FieldLabel}" FontSize="15" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Grid.Column="0"
                                 Style="{StaticResource BigTextBox}" FontSize="14" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Change Folder"
                                Style="{StaticResource SecondaryButton}"
                                Height="44" Width="150" Margin="10,0,0,0"
                                Click="OnChangeFolderClick" />
                    </Grid>
                    <TextBlock Text="Each patient gets their own folder inside this location."
                               Style="{StaticResource SubtitleText}" Margin="0,0,0,20" />

                    <TextBlock Text="Default Camera" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CameraCombo" Style="{StaticResource BigCombo}"
                              DisplayMemberPath="Name" Margin="0,0,0,18" />

                    <TextBlock Text="Default Microphone" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="MicCombo" Style="{StaticResource BigCombo}"
                              DisplayMemberPath="Name" Margin="0,0,0,18" />

                    <StackPanel x:Name="ScreenPanel">
                        <TextBlock Text="Default Screen" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ScreenCombo" Style="{StaticResource BigCombo}"
                                  DisplayMemberPath="Display" Margin="0,0,0,18" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,18" />

                    <CheckBox x:Name="ConfirmStopCheck"
                              Content="Ask for confirmation before stopping a recording"
                              FontSize="14" Margin="0,0,0,16" />

                    <TextBlock Text="Low storage warning (GB)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LowSpaceBox" Style="{StaticResource BigTextBox}"
                             FontSize="14" Width="120" HorizontalAlignment="Left" />
                    <TextBlock Text="A warning is shown before recording if less space than this is free."
                               Style="{StaticResource SubtitleText}" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Button Content="Open Log Folder" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Width="170" Click="OnOpenLogsClick" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Width="120" Margin="0,0,10,0" Click="OnCancelClick" />
                <Button Content="Save" Style="{StaticResource PrimaryButton}"
                        Width="140" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
