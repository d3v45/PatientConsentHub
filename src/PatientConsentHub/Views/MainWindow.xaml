<Window x:Class="PatientConsentHub.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient Consent Hub - A&amp;T"
        Height="760" Width="1120"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        KeyDown="OnWindowKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource ATLogoStyle}" Width="42" Height="42" />
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="PATIENT CONSENT HUB" Style="{StaticResource TitleText}" FontSize="18" />
                        <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource SubtitleText}" />
                    </StackPanel>
                </StackPanel>

                <Button Content="About" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Height="32" Padding="14,0" Click="OnAboutClick" />
            </Grid>
        </Border>

        <!-- ================= Idle / setup view ================= -->
        <Grid x:Name="SetupView" Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Camera preview -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Camera Preview"
                               Style="{StaticResource FieldLabel}" FontSize="15" />

                    <Border Grid.Row="1" Background="#101820" CornerRadius="6">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                            <TextBlock x:Name="PreviewMessage"
                                       Text="Starting camera..."
                                       Foreground="White" FontSize="16"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="420"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Controls -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Camera" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="CameraCombo" Style="{StaticResource BigCombo}"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="OnCameraChanged" Margin="0,0,0,16" />

                        <TextBlock Text="Microphone" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="MicCombo" Style="{StaticResource BigCombo}"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="OnMicChanged" Margin="0,0,0,12" />

                        <TextBlock Text="Microphone Level" Style="{StaticResource FieldLabel}" />
                        <ProgressBar x:Name="MicLevelBar" Height="18" Minimum="0" Maximum="100"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="#E7EDF1" BorderThickness="0" Margin="0,0,0,4" />
                        <TextBlock x:Name="MicHintText" Text="Speak to check the microphone."
                                   Style="{StaticResource SubtitleText}" Margin="0,0,0,18" />

                        <StackPanel x:Name="ScreenPanel" Visibility="Collapsed">
                            <TextBlock Text="Screen" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ScreenCombo" Style="{StaticResource BigCombo}"
                                      DisplayMemberPath="Display" Margin="0,0,0,18" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,18" />

                        <TextBlock Text="Patient ID" Style="{StaticResource FieldLabel}" FontSize="15" />
                        <TextBox x:Name="PatientIdBox" Style="{StaticResource BigTextBox}"
                                 TextChanged="OnPatientIdChanged" Margin="0,0,0,6" />
                        <TextBlock x:Name="PatientIdHint" Style="{StaticResource SubtitleText}"
                                   TextWrapping="Wrap" Margin="0,0,0,18" />

                        <TextBlock Text="Recording" Style="{StaticResource FieldLabel}" FontSize="15" />
                        <RadioButton x:Name="ConsentViewRadio" Style="{StaticResource BigRadio}"
                                     Content="Consent View" IsChecked="True"
                                     Checked="OnConsentTypeChanged" />
                        <RadioButton x:Name="ConsentScreenRadio" Style="{StaticResource BigRadio}"
                                     Content="Consent View + Screen"
                                     Checked="OnConsentTypeChanged" Margin="0,0,0,18" />

                        <Button x:Name="StartButton" Content="START RECORDING"
                                Style="{StaticResource StartButton}"
                                Click="OnStartClick" />

                        <TextBlock x:Name="ValidationText"
                                   Foreground="{StaticResource RecordBrush}"
                                   FontSize="13" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,10,0,0" />

                        <!-- Saved confirmation -->
                        <Border x:Name="SavedBanner" Visibility="Collapsed"
                                Background="#E8F5EE" BorderBrush="{StaticResource SuccessBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Recording saved successfully."
                                           FontWeight="SemiBold" FontSize="15"
                                           Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock x:Name="SavedDetailText" Style="{StaticResource SubtitleText}"
                                           TextWrapping="Wrap" Margin="0,4,0,10" />
                                <Button Content="Open Patient Folder" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Height="34"
                                        Click="OnOpenLastFolderClick" />
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,14" />

                        <Grid>
                            <Button Content="Settings" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Width="160" Click="OnSettingsClick" />
                            <Button Content="Recordings" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" Width="160" Click="OnHistoryClick" />
                        </Grid>

                        <TextBlock Text="F9 starts a recording. F10 stops it."
                                   Style="{StaticResource SubtitleText}"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= Recording view ================= -->
        <Grid x:Name="RecordingView" Grid.Row="1" Margin="20" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="40">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="RecordDot" Width="26" Height="26"
                                 Fill="{StaticResource RecordBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="RECORDING" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource RecordBrush}"
                                   Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="RecordingPatientText"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,28,0,0" />

                    <TextBlock x:Name="RecordingTypeText"
                               Style="{StaticResource SubtitleText}" FontSize="15"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />

                    <TextBlock x:Name="DurationText" Text="00:00:00"
                               FontSize="56" FontWeight="Bold"
                               FontFamily="Consolas"
                               Foreground="{StaticResource DeepBlueBrush}"
                               HorizontalAlignment="Center" Margin="0,22,0,32" />

                    <Button x:Name="StopButton" Content="STOP RECORDING"
                            Style="{StaticResource StopButton}"
                            Width="420" Click="OnStopClick" />

                    <TextBlock x:Name="StopStatusText"
                               Style="{StaticResource SubtitleText}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
