<Window x:Class="PatientConsentHub.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recordings - Patient Consent Hub"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Recording History" Style="{StaticResource TitleText}" />
            <TextBlock Text="Recent consent recordings on this computer."
                       Style="{StaticResource SubtitleText}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="HistoryGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeight="38"
                          FontSize="14"
                          SelectionMode="Single"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          Background="{StaticResource SurfaceBrush}"
                          RowBackground="{StaticResource SurfaceBrush}"
                          AlternatingRowBackground="#F8FAFB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientId}" Width="1.4*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="1*" />
                        <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="0.7*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="1.3*" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="0.8*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyText"
                           Text="No recordings yet."
                           Style="{StaticResource SubtitleText}"
                           FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Open Folder" Style="{StaticResource SecondaryButton}"
                        Width="160" Margin="0,0,10,0" Click="OnOpenFolderClick" />
                <Button Content="Play Recording" Style="{StaticResource SecondaryButton}"
                        Width="170" Click="OnPlayClick" />
            </StackPanel>
            <Button Content="Close" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Width="130" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
